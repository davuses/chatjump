{
  "manifest_version": 3,
  "name": "ChatJump — Conversation Navigator",
  "version": "1.0.2",
  "description": "Find and jump to questions in your ChatGPT conversations. A searchable table of contents that keeps every answer fully visible.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/chatgpt-dom.js",
        "src/turn-order.js",
        "src/conversation-api.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
